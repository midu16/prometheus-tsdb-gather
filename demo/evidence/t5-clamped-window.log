    [gather 15:43:15] DONE - mode=direct; TSDB in /must-gather/prometheus-snapshot/20261024T154253Z; archive=20261024T154253Z.tar.zstd; metadata in /must-gather/prometheus-metadata

$ jq "{window_clamped, original_request, since, until}" $P/prometheus-metadata/time-window.json
{
  "window_clamped": true,
  "original_request": {
    "since": "2026-09-24T15:42:44Z",
