{
  "uid": "sno-forensic-overview",
  "title": "SNO TSDB Forensics - Overview",
  "tags": ["sno", "forensic", "tsdb"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Prometheus Up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sno-tsdb" },
      "targets": [
        {
          "refId": "A",
          "expr": "prometheus_tsdb_storage_blocks_total",
          "legendFormat": "blocks"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Series / Samples",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sno-tsdb" },
      "targets": [
        { "refId": "A", "expr": "prometheus_tsdb_head_series", "legendFormat": "head series" },
        { "refId": "B", "expr": "prometheus_tsdb_head_active_appenders", "legendFormat": "active appenders" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Node CPU Usage %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "sno-tsdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Node Memory Used %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "sno-tsdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Node Disk Usage per Mount",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "sno-tsdb" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100, "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|shm\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|shm\"}))",
          "legendFormat": "{{mountpoint}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network Traffic (master-0)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "sno-tsdb" },
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum by (device) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|kube-.*|cilium_.*\"}[5m]))", "legendFormat": "rx {{device}}" },
        { "refId": "B", "expr": "sum by (device) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|kube-.*|cilium_.*\"}[5m]))", "legendFormat": "tx {{device}}" }
      ]
    }
  ]
}
