#!/usr/bin/bash
# =============================================================================
# gather  --  must-gather payload entrypoint for Prometheus TSDB extraction
#
# Must-gather contract (see openshift/must-gather must-gather.md DESIGN section):
#   1. Zero-arg executable at /usr/bin/gather
#   2. Writes everything meant to be shipped back into /must-gather
#      (the MUST_GATHER env var holds this path; we default to /must-gather so
#      the script can also run outside the framework for debugging)
#   3. Writes /must-gather/version (line 1: product, line 2: version)
#   4. Must NOT leak sensitive data (tokens, certs) into /must-gather
#
# SAFEGUARDS (v1.3.0) -- see features/safeguard-size-selective-export.md
#
# Size budget (pre-flight gate, BEFORE any bytes are copied):
#   --max-size <bytes|1Gi|512Mi|...>   or   MAX_GATHER_BYTES=<bytes>
#       projected export (sum of SELECTED blocks + WAL if included) is
#       compared against the budget; default 2 GiB, "none" = disabled.
#   --size-policy fail|warn            or   SIZE_POLICY
#       fail (default): FATAL + actionable error message before the copy.
#       warn: log loudly, continue.
#   On a budget miss the script prints a stable, machine-grepable block
#   (FATAL: projected must-gather TSDB export exceeds size budget ...) and
#   writes prometheus-metadata/size-budget.txt, then exits non-zero
#   (policy=fail) without copying anything.
#
# Time-window export (selective, source-side: only selected paths leave the
#   prometheus pod; block granularity = complete ULID dirs, never split):
#   --since <ts>   or   SINCE     e.g. 2026-09-29T10:00:00Z, 6h, 2d,
#                                 "24 hours ago", unix seconds, 'now'
#   --until <ts>   or   UNTIL     same formats; default 'now'
#   --include-wal true|false      or   INCLUDE_WAL
#       copy WAL + chunks_head when the window reaches the head.
#       Default: true when until is within 1h of now, else false.
#   Blocks whose [minTime,maxTime] INTERSECTS [since,until] are copied; all
#   other blocks never leave the pod. No intersecting block -> FATAL before
#   the copy. Retention is detected and compared against the window; a
#   window older than retention fails with a hint (Tier A+B of the feature
#   doc; live retention patching is intentionally NOT implemented).
#   Artifacts: time-window.json, retention.txt.
#
# Compression (measured 2026-10-02 on a 1.1GB SNO TSDB, see the feature doc
#   Outcomes): zstd -6 yields ~74% size reduction in ~0.5s -> the default.
#   --compress none|zstd|gzip        or   COMPRESS
#       the extracted copy is archived as
#         prometheus-snapshot/<TS>.tar.zstd   (COMPRESS=zstd)
#         prometheus-snapshot/<TS>.tar.gz     (COMPRESS=gzip)  + SHA256SUMS
#       after extraction (the block tree itself stays intact next to the
#       archive; compression runs locally, CPU-bound, cheap).
#       NOTE: the suffix is '.tar.' + $COMPRESS, so the zstd archive is named
#       <TS>.tar.zstd (NOT zstd's default .zst). Unpack for playback:
#         tar -I zstd -xf <TS>.tar.zstd -C <dir>
#       (PLAYBACK still mounts the UNPACKED dir; the archive is for
#       transfer/storage, and both forms verify via SHA256SUMS).
#
# Legacy (v1.2.0, still supported post-copy, on the LOCAL copy):
#   --max-gb <n>   or   GATHER_TSDB_MAX_GB=<n>     (default 5)
#   --at <ts>      or   GATHER_TSDB_AT=<ts>
#   These prune the local copy after extraction (oldest blocks first); the
#   pre-flight budget above is the recommended gate - --max-gb/--at remain
#   for backward compatibility with existing playbooks.
#
# AUTH MODEL
#   The operator's local kubeconfig (cluster-admin) is delivered by
#   run-must-gather.sh, which creates a Secret and makes the framework's
#   container command bootstrap it into the pod at
#       /etc/must-gather-kubeconfig/kubeconfig
#   BEFORE /usr/bin/gather runs (see that script for the exact mechanism).
#   This script exports KUBECONFIG for EVERY oc call below.
#   Fallback: if the file is absent (plain 'oc adm must-gather --image
#   <custom>' without the wrapper), the framework's in-cluster
#   cluster-admin SA token is used (verified working: the pod gets the
#   must-gather-*-clusterrolebinding) - so the payload works both ways.
#   The injected kubeconfig itself is NEVER copied into /must-gather (rule 4).
#
# Flow: auth bootstrap -> pre-flight -> extraction:
#   MODE=snapshot  (preferred, when the admin API is enabled):
#       POST /api/v1/admin/tsdb/snapshot -> oc cp snapshots/<ts> out -> rm remote
#   MODE=direct    (fallback, the VERIFIED reality of this cluster:
#       Prometheus 3.13.2, OCP operator does NOT enable the
#       prometheus-admin-api feature, Admin API answers 500
#       "admin APIs disabled"):
#       oc cp the live TSDB dir /prometheus out as-is. A TSDB on disk
#       (compacted block dirs + WAL + chunks_head) is crash-consistent by
#       design: a local prometheus re-opening the copy replays the WAL and
#       loses at most the torn tail of the newest WAL segment. NOTHING is
#       written to the target pod; there is nothing to clean up.
#   -> forensic metadata -> remote cleanup (snapshot mode only)
#
# KNOWN PAYLOAD-CLIENT QUIRK: the ose-must-gather base ships an oc 4.15 client;
#   'oc whoami' there takes NO --timeout flag (verified: fails with
#   'unknown flag'). All oc calls below are therefore written to be
#   4.15-compatible.
# =============================================================================
set -uo pipefail

# ---------------------------------------------------------------------------
# Flags (the must-gather contract prefers zero-arg, but the framework passes
# through extra args from `oc adm must-gather --cmd "gather <args>"`; they are
# all optional and overrideable by env for in-pod hand runs. The wrapper
# run-must-gather.sh forwards its own flags as env - prefer the wrapper.)
#
#   Size safeguard:
#     --max-size <size>    bytes, or N{K,M,G,T}{i,B} (default: 2Gi; none=off)
#                          (env: MAX_GATHER_BYTES)
#     --size-policy fail|warn   (env: SIZE_POLICY, default fail)
#   Time-window export:
#     --since <ts>         RFC3339 / "6h" / "2d" / "24 hours ago" / epoch (env: SINCE)
#     --until <ts>         same, default now                    (env: UNTIL)
#     --include-wal true|false  copy WAL+chunks_head (env: INCLUDE_WAL;
#                          default true when until is within an hour of now)
#   Compression:
#     --compress none|zstd|gzip   (env: COMPRESS, default zstd)
#   Legacy post-copy guards (v1.2.0, applied to the LOCAL copy after extract):
#     --max-gb <n>         cap in GiB, oldest blocks pruned (env: GATHER_TSDB_MAX_GB, default 5)
#     --at <ts>            prune blocks starting after <ts> (env: GATHER_TSDB_AT)
#   -h, --help             print usage
# ---------------------------------------------------------------------------
usage() {
    cat <<'EOF'
gather [options]
Size safeguard (pre-flight, before any copy):
  --max-size <size>    projected-export budget: bytes, or N{K,M,G,T}{i,B}
                       (default 2Gi; 'none' disables)   (env: MAX_GATHER_BYTES)
  --size-policy fail|warn
                       fail = abort with FATAL before the copy (default)
                       warn = log loudly and continue    (env: SIZE_POLICY)
Time-window export (selective, block-granular, source-side):
  --since <ts>         inclusive lower bound (env: SINCE)
  --until <ts>         inclusive upper bound, default now (env: UNTIL)
  --include-wal true|false
                       copy WAL + chunks_head            (env: INCLUDE_WAL;
                       auto: true when until is within 1h of now)
  <ts> = RFC3339 (2026-09-29T10:00:00Z), relative (6h, 2d, 'now'),
       anything GNU date parses, or unix seconds.
Compression:
  --compress none|zstd|gzip
                       archive the extracted copy (default: zstd -6)
                       (env: COMPRESS)
Legacy post-copy guards (local copy; see v1.2.0 notes):
  --max-gb <n>         cap the exported copy to <n> GiB (default: 5)
                 (env: GATHER_TSDB_MAX_GB)
  --at <ts>            prune local blocks starting after <ts>
                 (env: GATHER_TSDB_AT)
  -h, --help           this help
EOF
}

MAX_SIZE="${MAX_GATHER_BYTES:-2Gi}"
SIZE_POLICY="${SIZE_POLICY:-fail}"
SINCE="${SINCE:-}"
UNTIL="${UNTIL:-now}"
INCLUDE_WAL="${INCLUDE_WAL:-auto}"
COMPRESS="${COMPRESS:-zstd}"
# legacy
MAX_GB="${GATHER_TSDB_MAX_GB:-5}"
AT_TS="${GATHER_TSDB_AT:-}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --max-size)     MAX_SIZE="${2:?--max-size needs a value}"; shift 2 ;;
        --size-policy)  SIZE_POLICY="${2:?--size-policy needs a value}"; shift 2 ;;
        --since)        SINCE="${2:?--since needs a value}"; shift 2 ;;
        --until)        UNTIL="${2:?--until needs a value}"; shift 2 ;;
        --include-wal)  INCLUDE_WAL="${2:?--include-wal needs a value}"; shift 2 ;;
        --compress)     COMPRESS="${2:?--compress needs a value}"; shift 2 ;;
        --max-gb)       MAX_GB="${2:?--max-gb needs a value}"; shift 2 ;;
        --at)           AT_TS="${2:?--at needs a value}"; shift 2 ;;
        -h|--help)      usage; exit 0 ;;
        *)              echo "gather: unknown flag: $1" >&2; usage >&2; exit 64 ;;
    esac
done

# ---------------------------------------------------------------------------
# flag validation + parsing (all hard errors up front, exit 64)
# ---------------------------------------------------------------------------
human_size_to_bytes() {
    # 512, 512K, 512Mi, 2G, none... -> integer bytes; echoes none for none|""
    local s="$1"
    [[ -z "${s}" || "${s,,}" == "none" || "${s,,}" == "off" || "${s,,}" == "disabled" ]] \
        && { echo none; return; }
    [[ "${s}" =~ ^([0-9]+)([A-Za-z]*)$ ]] || { echo ""; return; }
    local num="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}"
    case "${unit}" in
        ""|"B"|"b")                 echo $(( num )) ;;
        "K"|"k"|"Kb"|"kb"|"Ki"|"ki")          echo $(( num * 1024 )) ;;
        "M"|"m"|"Mb"|"mb"|"Mi"|"mi")          echo $(( num * 1024 * 1024 )) ;;
        "G"|"g"|"Gb"|"gb"|"Gi"|"gi")          echo $(( num * 1024 * 1024 * 1024 )) ;;
        "T"|"t"|"Tb"|"tb"|"Ti"|"ti")          echo $(( num * 1024 * 1024 * 1024 * 1024 )) ;;
        *) echo "" ;;
    esac
}

MAX_BYTES="$(human_size_to_bytes "${MAX_SIZE}")"
if [[ "${MAX_BYTES}" == "none" ]]; then
    MAX_BYTES=""                    # budget disabled
elif [[ -z "${MAX_BYTES}" ]]; then
    echo "gather: cannot parse --max-size '${MAX_SIZE}' (bytes or N[K|M|G|T][iB], or 'none')" >&2
    exit 64
fi

case "${SIZE_POLICY}" in
    fail|warn) : ;;
    *) echo "gather: --size-policy must be 'fail' or 'warn', got: ${SIZE_POLICY}" >&2; exit 64 ;;
esac
case "${COMPRESS}" in
    none|zstd|gzip) : ;;
    *) echo "gather: --compress must be none|zstd|gzip, got: ${COMPRESS}" >&2; exit 64 ;;
esac
case "${INCLUDE_WAL}" in
    true|false|auto) : ;;
    *) echo "gather: --include-wal must be true|false|auto, got: ${INCLUDE_WAL}" >&2; exit 64 ;;
esac
# legacy --max-gb
[[ "${MAX_GB}" =~ ^[1-9][0-9]*$ ]] \
    || { echo "gather: --max-gb must be a positive integer, got: ${MAX_GB}" >&2; exit 64; }
LEGACY_MAX_BYTES=$(( MAX_GB * 1024 * 1024 * 1024 ))

# Prometheus-style relative duration ('6h', '2d', '3d12h', '90m', '12s')
# -> unix seconds in the PAST. GNU date does NOT parse '6h' as a duration
# (it means 06:00 UTC!) and '1w' is not a GNU unit either - so the
# Prometheus letter format is translated to GNU relative syntax
# ('3d12h' -> 'now - 3 days - 12 hours'). Note 'now - X ago' is WRONG
# (verified: 'ago' is ignored, the relative part then re-anchors), the
# correct form is 'now - X <unit>'.
parse_rel_seconds() {
    local s="$1" units=""
    while [[ "${s}" =~ ^([0-9]+)([hdwms]) ]]; do
        local n="${BASH_REMATCH[1]}" u="${BASH_REMATCH[2]}"
        case "${u}" in
            d) units+="- ${n} days " ;;
            w) units+="- $(( n * 7 )) days " ;;
            h) units+="- ${n} hours " ;;
            m) units+="- ${n} minutes " ;;
            s) units+="- ${n} seconds " ;;
        esac
        s="${s:${#BASH_REMATCH[0]}}"
    done
    [[ -z "${s}" && -n "${units}" ]] || return 1
    date -u -d "now ${units}" +%s 2>/dev/null
}

# <ts> -> unix seconds: 'now', Prometheus relative (6h/2d/3d12h/90m),
# GNU-date strings ("24 hours ago", absolute RFC3339), epoch seconds.
# Emitted empty on failure.
parse_ts_seconds() {
    local t="$1" r
    [[ -n "${t}" ]] || return 1
    [[ "${t}" =~ ^-?now$ ]] && t="now"
    if [[ "${t}" =~ ^[0-9]+$ ]]; then
        echo "${t}"; return
    fi
    # Prometheus letter-durations FIRST: date -d '6h' would silently mean
    # 06:00 UTC (verified pitfall). '6H' etc. is normalized to the
    # Prometheus lowercase form; the match requires NUMBER+UNIT pairs only,
    # so '6 hours' / '3d12h-ish' prose never enters this branch.
    if [[ "${t,,}" =~ ^([0-9]+[hdwms])+$ ]]; then
        r="$(parse_rel_seconds "${t,,}")" && { echo "${r}"; return; }
    fi
    date -u -d "${t}" +%s 2>/dev/null || date -u -d "now ${t}" +%s 2>/dev/null
}

SINCE_SECONDS=""
UNTIL_SECONDS=""
if [[ -n "${SINCE}" ]]; then
    SINCE_SECONDS="$(parse_ts_seconds "${SINCE}")" \
        || { echo "gather: cannot parse --since '${SINCE}'" >&2; exit 64; }
    if [[ -z "${SINCE_SECONDS}" ]]; then
        echo "gather: cannot parse --since '${SINCE}'" >&2; exit 64
    fi
fi
UNTIL_SECONDS="$(parse_ts_seconds "${UNTIL}")"
[[ -n "${UNTIL_SECONDS}" ]] \
    || { echo "gather: cannot parse --until '${UNTIL}'" >&2; exit 64; }
if [[ -n "${SINCE_SECONDS}" ]] && (( SINCE_SECONDS > UNTIL_SECONDS )); then
    echo "gather: --since (${SINCE}) is after --until (${UNTIL})" >&2; exit 64
fi

# legacy --at (kept for v1.2.0 playbooks)
AT_SECONDS=""
if [[ -n "${AT_TS}" ]]; then
    AT_SECONDS=$(date -u -d "${AT_TS}" +%s 2>/dev/null) \
        || { echo "gather: cannot parse --at timestamp: ${AT_TS}" >&2; exit 64; }
fi

# window is 'active' when the operator asked for less than everything:
# a since bound, or an until that is not the literal default 'now'
# (a past until also prunes newer blocks - e.g. --at-style point exports)
WINDOW_ACTIVE=0
if [[ -n "${SINCE_SECONDS}" || "${UNTIL}" != "now" ]]; then
    WINDOW_ACTIVE=1
fi

# ---------------------------------------------------------------------------
# Configuration / environment
# ---------------------------------------------------------------------------
SNO_NODE="master-0"                       # the single node of this SNO install
MON_NS="openshift-monitoring"             # namespace hosting Prometheus on OCP
PROM_POD="${PROM_POD:-prometheus-k8s-0}"  # can be overridden; default = the
                                           # well-known name of the k8s prometheus
PROM_CONTAINER="prometheus"               # container name inside the prom pod
PROM_DATA_DIR="/prometheus"               # prometheus -storage.tsdb.path on-disk
PROM_SNAP_DIR="${PROM_DATA_DIR}/snapshots"   # Admin API writes <dir>/snapshots/<ts>
ADMIN_TIMEOUT=10                          # seconds per curl to the Admin API
OUT_DIR="${MUST_GATHER:-/must-gather}"    # the rsync-able output dir
TSDB_OUT_DIR="${OUT_DIR}/prometheus-snapshot"
METADATA_DIR="${OUT_DIR}/prometheus-metadata"
SNAPSHOT_NAME=""                          # set once snapshot succeeds (used by trap)

# The injected kubeconfig (see AUTH MODEL in the header). Path is the
# framework-standard volume mount added by run-must-gather.sh; the env var
# lets a developer point at a file when running this script in-cluster by hand
# (e.g. via 'oc debug' into the gather pod).
KUBECONFIG_MOUNT_PATH="/etc/must-gather-kubeconfig/kubeconfig"
KUBECONFIG_FILE="${MUST_GATHER_KUBECONFIG:-${KUBECONFIG_MOUNT_PATH}}"

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------
log()  { echo "[gather $(date -u +%H:%M:%S)] $*" | tee -a "${OUT_DIR}/gather.log"; }
fail() { log "FATAL: $*"; exit 1; }
warn() { log "WARN: $*"; }

MODE="snapshot"                      # snapshot | direct (decided in PART 1)
PROM_PORT=""                         # resolved in 0d (9091 or 9090)

# Best-effort cleanup so we NEVER leave a stale admin-API snapshot behind on
# the target prometheus pod, even if the gather pod is force-deleted or the
# script aborts. Removing a snapshot is safe: it is a pure copy of the
# crash-consistent TSDB (documented behavior; the live TSDB is not touched).
# Direct mode (fallback) performs NO writes to the pod at all - there is
# nothing to clean up in that case.
cleanup_remote() {
    if [[ "${MODE}" == "snapshot" && -n "${SNAPSHOT_NAME}" ]]; then
        log "Cleanup: removing snapshot '${SNAPSHOT_NAME}' on ${PROM_POD}"
        oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
            rm -rf "${PROM_SNAP_DIR}/${SNAPSHOT_NAME}" 2>/dev/null || \
            warn "could not remove remote snapshot (pod gone?)"
    fi
}
trap cleanup_remote EXIT

mkdir -p "${OUT_DIR}" "${TSDB_OUT_DIR}" "${METADATA_DIR}"

# ---------------------------------------------------------------------------
# /must-gather/version  (framework convention: 2-line version file)
# ---------------------------------------------------------------------------
{
    echo "prometheus-tsdb-must-gather"
    echo "1.3.0"
} > "${OUT_DIR}/version"

# ---------------------------------------------------------------------------
# export_tsdb_guard <dir>: enforce the size cap and --at point-in-time filter
# on a LOCAL TSDB copy (never the live pod).
#
# Blocks are the only unit that can be dropped safely offline: each block dir
# is self-contained (meta.json + index + chunks) and a prometheus opening the
# remaining blocks + WAL loads exactly what is present. Prune order:
#   1. --at   : drop blocks whose minTime is AFTER the requested instant
#               (block granularity; the WAL is kept - it holds recent head
#               data and the re-opening prometheus replays it as-is)
#   2. size   : while the copy exceeds the cap, drop the OLDEST block first
#               (ULID sort == chronological order) until under the cap
# ---------------------------------------------------------------------------
export_tsdb_guard() {
    local dir="$1"
    local report="${METADATA_DIR}/export-guards.txt"
    local pruned_at="" pruned_size="" kept_count=0 final_size=0

    # collect: name \t minTime(ms) \t size(bytes)  for every block dir
    local blocks=""
    while IFS= read -r line; do
        [[ -n "${line}" ]] && blocks+="${line}"$'\n'
    done < <(
        for b in "${dir}"/*/; do
            [[ -d "${b}" && -f "${b}meta.json" ]] || continue
            local n; n=$(basename "${b}")
            [[ "${n}" =~ ^[0-9A-Z]{26}$ ]] || continue
            local mt sz
            mt=$(jq -r '.minTime // empty' "${b}meta.json" 2>/dev/null)
            [[ "${mt}" =~ ^[0-9]+$ ]] || mt=0
            sz=$(find "${b}" -type f -printf '%s\n' 2>/dev/null | awk '{s+=$1} END{print s+0}')
            printf '%s\t%s\t%s\n' "${n}" "${mt}" "${sz:-0}"
        done
    )

    # -- at filter -------------------------------------------------------
    if [[ -n "${AT_SECONDS}" ]]; then
        local kept="" dropped=""
        while IFS=$'\t' read -r n mt sz; do
            [[ -n "${n}" ]] || continue
            if (( mt / 1000 > AT_SECONDS )); then
                dropped+="${n} "
                rm -rf -- "${dir}/${n}"
            else
                kept+="${n} "
            fi
        done <<< "${blocks}"
        if [[ -n "${dropped}" ]]; then
            pruned_at="${dropped}"
            log "Guard --at: pruned blocks starting after $(date -u -d "@${AT_SECONDS}" +%Y-%m-%dT%H:%M:%SZ): ${dropped}"
        fi
    fi

    # -- size cap --------------------------------------------------------
    local total name
    total=$(du -sb -- "${dir}" 2>/dev/null | awk '{print $1}')
    total=${total:-0}
    if (( total > LEGACY_MAX_BYTES )); then
        log "Guard size: copy is $(( total / 1024 / 1024 )) MiB - over ${MAX_GB} GiB cap; pruning oldest blocks"
        while (( total > LEGACY_MAX_BYTES )); do
            # oldest remaining block (ULID sort = chronological)
            name=$(ls -1 "${dir}" 2>/dev/null | grep -E '^[0-9A-Z]{26}$' | sort | \
                   while read -r c; do
                       [[ -f "${dir}/${c}/meta.json" ]] && { echo "${c}"; break; }
                   done)
            if [[ -z "${name}" ]]; then
                warn "Guard size: cannot reach cap by pruning (WAL/chunks_head alone exceed ${MAX_GB} GiB)"
                break
            fi
            local bsz
            bsz=$(du -sb -- "${dir}/${name}" 2>/dev/null | awk '{print $1}')
            bsz=${bsz:-0}
            rm -rf -- "${dir}/${name}"
            total=$(( total - bsz ))
            pruned_size+="${name} "
            log "Guard size: removed oldest block ${name} -> $(( total / 1024 / 1024 )) MiB"
        done
    fi

    # -- report ----------------------------------------------------------
    kept_count=$(ls -1 "${dir}" 2>/dev/null | grep -cE '^[0-9A-Z]{26}$' || true)
    final_size=$(du -sb -- "${dir}" 2>/dev/null | awk '{print $1}')
    {
        echo "max_cap_gi=${MAX_GB}"
        echo "at_timestamp=${AT_TS:-(not set)}"
        echo "at_seconds=${AT_SECONDS:-(not set)}"
        echo "pruned_blocks_after_at=${pruned_at:-(none)}"
        echo "pruned_blocks_for_size=${pruned_size:-(none)}"
        echo "blocks_remaining=${kept_count}"
        echo "final_copy_bytes=${final_size:-0}"
        echo "final_copy_under_cap=$( (( ${final_size:-0} <= LEGACY_MAX_BYTES )) && echo yes || echo no )"
        [[ -n "${pruned_at}${pruned_size}" ]] \
            && echo "note=export is PRUNED: missing blocks listed above; WAL kept intact"
    } > "${report}"
}

# ---------------------------------------------------------------------------
# REMOTE BLOCK INVENTORY (source-side, used by window selection + budget):
#   one line per compacted block dir:  ULID<TAB>minTime_s<TAB>maxTime_s<TAB>size_bytes
# parsed from meta.json with awk (the prometheus container has no jq; the
# remote sh is dash - POSIX only, no bash arrays). minTime/maxTime are
# millis in meta.json. Blocks not listed here exist only inside the pod.
# ---------------------------------------------------------------------------
remote_meta_field() {
    # $1=block ULID  $2=field (minTime|maxTime): one remote awk pass, no shell
    # wrapper (the prometheus container has no jq). meta.json is pretty
    # printed, one key per line ("\t\"minTime\"": 12345,): split on ':',
    # match the wanted key field, take the next field.
    oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
        awk -F: -v f="${2}" '{for (i=1;i<=NF;i++) {t=$i; gsub(/[ \t\""]/,"",t); if (t==f) {v=$(i+1); gsub(/[^0-9]/,"",v); if (v ~ /^[0-9]+$/) {print v; exit}}}}' \
            "${PROM_DATA_DIR}/$1/meta.json" 2>/dev/null
}

remote_block_inventory() {
    # one line per compacted block dir:  ULID<TAB>minTime_s<TAB>maxTime_s<TAB>bytes
    oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
        sh -c 'ls -1 '"${PROM_DATA_DIR}"' 2>/dev/null' \
        | while IFS= read -r n; do
            [[ "${n}" =~ ^[0-9A-Z]{26}$ ]] || continue
            local mt xt sz
            mt=$(remote_meta_field "${n}" minTime)
            xt=$(remote_meta_field "${n}" maxTime)
            sz=$(oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
                du -sb "${PROM_DATA_DIR}/${n}" 2>/dev/null | awk '{print $1}')
            [[ -n "${mt}" && "${mt}" =~ ^[0-9]+$ ]] || mt=0
            [[ -n "${xt}" && "${xt}" =~ ^[0-9]+$ ]] || xt=$(( mt + 3600000 ))
            [[ -n "${sz}" && "${sz}" =~ ^[0-9]+$ ]] || sz=0
            printf '%s\t%s\t%s\t%s\n' "${n}" $(( mt / 1000 )) $(( xt / 1000 )) "${sz}"
        done
}

# size of one pod dir in bytes (0 on failure)
remote_dir_bytes() {
    local p="$1" v
    v=$(oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
        du -sb "${PROM_DATA_DIR}/${p}" 2>/dev/null | awk '{print $1}')
    [[ -n "${v}" && "${v}" =~ ^[0-9]+$ ]] && echo "${v}" || echo 0
}

# ---------------------------------------------------------------------------
# TIME-WINDOW SELECTION (feature: selective export).
#   INVOCATION: select_window "<inventory lines>"
#   SELECTED_BLOCKS : ULIDs whose [min, max] INTERSECTS [since, until]
#   EXCLUDED_BLOCKS : the rest (never leave the pod)
#   WAL_INCLUDED    : 1/0 (INCLUDE_WAL resolution: auto -> 1 when the window
#                     reaches the head, i.e. until >= now - 3600s)
#   OLDEST_MS / NEWEST_MS : data bounds actually present on the PVC
# Fails hard (stable message) when nothing intersects the window.
# ---------------------------------------------------------------------------
SELECTED_BLOCKS=""
EXCLUDED_BLOCKS=""
WAL_INCLUDED=0
OLDEST_MS=0
NEWEST_MS=0

select_window() {
    local inv="$1"
    local now_s; now_s=$(date -u +%s)
    # INCLUDE_WAL resolution ('auto': window touches the last hour)
    if [[ "${INCLUDE_WAL}" == "auto" ]]; then
        if (( UNTIL_SECONDS >= now_s - 3600 )); then WAL_INCLUDED=1; else WAL_INCLUDED=0; fi
    else
        [[ "${INCLUDE_WAL}" == "true" ]] && WAL_INCLUDED=1
    fi

    [[ -n "${inv}" ]] \
        || fail "no compacted TSDB blocks found in ${PROM_DATA_DIR} (only head/WAL?) - cannot select a window"

    local n mt xt kept=0
    while IFS=$'\t' read -r n mt xt _sz; do
        [[ -n "${n}" ]] || continue
        local mt_ms=$(( mt * 1000 )) xt_ms=$(( xt * 1000 ))
        if (( mt_ms < OLDEST_MS || OLDEST_MS == 0 )); then OLDEST_MS=${mt_ms}; fi
        if (( xt_ms > NEWEST_MS )); then NEWEST_MS=${xt_ms}; fi
        if [[ -n "${SINCE_SECONDS}" ]] && (( xt_ms < SINCE_SECONDS * 1000 )); then
            EXCLUDED_BLOCKS+="${n} "
            continue
        fi
        if [[ "${UNTIL}" != "now" ]] && (( mt_ms > UNTIL_SECONDS * 1000 )); then
            EXCLUDED_BLOCKS+="${n} "
            continue
        fi
        SELECTED_BLOCKS+="${n} "
        kept=1
    done <<< "${inv}"
    if [[ ${kept} -eq 0 && ${WINDOW_ACTIVE} -eq 1 ]]; then
        # windowless (full) runs select everything; only an explicit window
        # can come back empty, and an empty window is a hard error (contract)
        log "FATAL: no TSDB blocks intersect the requested time window"
        log "  since=${SINCE:-<oldest>}  until=${UNTIL}"
        log "  oldest_block=$(date -u -d "@$(( OLDEST_MS / 1000 ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)  newest_block=$(date -u -d "@$(( NEWEST_MS / 1000 ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
        log "  retention_hint=see prometheus-metadata/retention.txt"
        log "  hint: widen the window (--since/--until) or verify cluster retention still holds this period"
        exit 1
    fi
    log "Window: selected $(tr ' ' '\n' <<<"${SELECTED_BLOCKS}" | grep -c .) of $(tr ' ' '\n' <<<"${inv}" | grep -c .) blocks; selected=[${SELECTED_BLOCKS}] excluded=[${EXCLUDED_BLOCKS:-(none)}] wal_included=${WAL_INCLUDED}"
}

# ---------------------------------------------------------------------------
# RETENTION DETECTION (tier A of the feature: always; tier B: compare window)
# Effective retention = prometheus CR spec.retention, else startup flag,
# else 'unknown'. Data bounds come from the block inventory above.
# ---------------------------------------------------------------------------
RETENTION_EFFECTIVE="unknown"
retention_detect() {
    local cr
    cr=$(oc get -n "${MON_NS}" prometheus k8s -o jsonpath='{.spec.retention}' 2>/dev/null || true)
    [[ -n "${cr}" ]] || cr=$(oc get -n "${MON_NS}" pod "${PROM_POD}" \
        -o jsonpath='{range .spec.containers[?(@.name=="prometheus")].args[*]}{.}{"\n"}{end}' 2>/dev/null \
        | grep -oE -- '--storage\.tsdb\.retention[.a-z]*=[0-9a-zA-Z]+' | head -1 || true)
    [[ -n "${cr}" ]] && RETENTION_EFFECTIVE=$(grep -oE '[0-9]+[a-zA-Z]+' <<<"${cr}" | head -1)
    local now_s; now_s=$(date -u +%s)
    local verdict="ok"
    if [[ -n "${SINCE_SECONDS}" ]]; then
        # data on disk starts at OLDEST_MS; nothing older can exist
        if (( OLDEST_MS > SINCE_SECONDS * 1000 )); then
            verdict="window_older_than_available_data"
        fi
    fi
    {
        echo "retention_effective=${RETENTION_EFFECTIVE}"
        echo "retention_source=prometheus CR spec.retention / --storage.tsdb.retention* flag"
        echo "data_oldest_block=$(( OLDEST_MS / 1000 ))s  ($(date -u -d "@$(( OLDEST_MS / 1000 ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null))"
        echo "data_newest_block=$(( NEWEST_MS / 1000 ))s  ($(date -u -d "@$(( NEWEST_MS / 1000 ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null))"
        echo "requested_since=${SINCE:-<oldest>}"
        echo "requested_until=${UNTIL}"
        echo "window_vs_data=${verdict}"
        echo "note=tier A(detect)+B(advise) only: live retention patching (tier C) intentionally not implemented"
    } > "${METADATA_DIR}/retention.txt"
    if [[ "${verdict}" == "window_older_than_available_data" ]]; then
        log "FATAL: requested window starts before the oldest data on disk"
        log "  since=${SINCE}  oldest_block=$(date -u -d "@$(( OLDEST_MS / 1000 ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
        log "  retention_hint=see prometheus-metadata/retention.txt (retention=${RETENTION_EFFECTIVE})"
        log "  hint: widen --since, or (break-glass lab clusters only) raise retention - not implemented by this toolkit"
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# SIZE BUDGET GATE (feature: safeguard, pre-flight, BEFORE the copy)
#   projected = sum(selected block sizes) + (wal+chunks_head if included)
#   [windowless runs project the full TSDB - same number as the inventory]
# Writes prometheus-metadata/size-budget.txt; honors SIZE_POLICY.
# INVOCATION: size_budget_gate "<inventory lines>"
# ---------------------------------------------------------------------------
size_budget_gate() {
    local inv="$1"
    local projected=0 n mt xt sz add
    while IFS=$'\t' read -r n mt xt sz; do
        [[ -n "${n}" ]] || continue
        case " ${SELECTED_BLOCKS} " in *" ${n} "*) projected=$(( projected + sz )) ;; esac
    done <<< "${inv}"
    if (( WAL_INCLUDED )); then
        add=$(( $(remote_dir_bytes "wal") + $(remote_dir_bytes "chunks_head") ))
        projected=$(( projected + add ))
    fi
    local budget_display="${MAX_SIZE}"
    [[ -n "${MAX_BYTES}" ]] && budget_display="${MAX_SIZE} (${MAX_BYTES} bytes)"
    local decision="disabled"
    if [[ -n "${MAX_BYTES}" ]]; then
        if (( projected > MAX_BYTES )); then
            decision="deny"
        else
            decision="allow"
        fi
    fi
    {
        echo "budget=${MAX_SIZE:-(unset)}"
        echo "policy=${SIZE_POLICY}"
        echo "mode=${MODE}"
        echo "window=${WINDOW_ACTIVE:0:1} since=${SINCE:-(oldest)} until=${UNTIL}"
        echo "blocks_selected=$(tr ' ' '\n' <<<"${SELECTED_BLOCKS:-(full)}" | grep -c .)/$(tr ' ' '\n' <<<"${SELECTED_BLOCKS} ${EXCLUDED_BLOCKS}" | grep -c .)"
        echo "wal_included=${WAL_INCLUDED}"
        echo "projected_bytes=${projected}"
        echo "projected_human=$(awk -v b=${projected} 'BEGIN{printf "%.1f MiB", b/1048576}')"
        echo "budget_bytes=${MAX_BYTES:-(disabled)}"
        echo "compress=${COMPRESS}"
        echo "decision=${decision}"
        [[ "${decision}" == "allow" ]] && echo "note=projection computed from remote block inventory (pre-copy); compression applied AFTER extraction does not change what the gather pod has to hold"
    } > "${METADATA_DIR}/size-budget.txt"
    case "${decision}" in
        deny)
            if [[ "${SIZE_POLICY}" == "warn" ]]; then
                log "WARN: projected must-gather TSDB export exceeds size budget (policy=warn, continuing)"
                log "  projected=$(( projected / 1024 / 1024 ))MiB  budget=$(awk -v b=${MAX_BYTES} 'BEGIN{printf "%.1f MiB", b/1048576}')  policy=warn"
            else
                # stable, machine-grepable contract (feature doc §1.3)
                log "FATAL: projected must-gather TSDB export exceeds size budget"
                log "  projected=$(( projected / 1024 / 1024 ))MiB  budget=$(awk -v b=${MAX_BYTES} 'BEGIN{printf "%.1f MiB", b/1048576}')  policy=${SIZE_POLICY}"
                log "  mode=${MODE}  blocks_selected=$(tr ' ' '\n' <<<"${SELECTED_BLOCKS}" | grep -c .)/$(tr ' ' '\n' <<<"${SELECTED_BLOCKS} ${EXCLUDED_BLOCKS}" | grep -c .)  window=${WINDOW_ACTIVE:0:1} since=${SINCE:-(oldest)} until=${UNTIL}"
                log "  hint: narrow the window with --since/--until (or SINCE/UNTIL),"
                log "        raise MAX_GATHER_BYTES (or --max-size), or free space on the gather volume / --dest-dir"
                log "  see: prometheus-metadata/size-budget.txt"
                exit 1
            fi
            ;;
        allow)
            log "Budget: projected $(awk -v b=${projected} 'BEGIN{printf "%.1f MiB", b/1048576}') <= budget ${budget_display} (policy=${SIZE_POLICY}) - allowed"
            ;;
        disabled)
            log "Budget: disabled (MAX_GATHER_BYTES=none) - no size gate this run"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# PART -1 - AUTHENTICATION: bind every oc/curl call to the operator's kubeconfig
#
# run-must-gather.sh appends a Secret volume to the gather init container:
#   volumes:     [{name: kubeconfig, secret: {secretName: <ns>/mg-kubeconfig}}]
#   volumeMounts:[{name: kubeconfig, mountPath: /etc/must-gather-kubeconfig}]
# KUBECONFIG is exported HERE - all later 'oc' invocations in this script
# (and any it spawns) inherit it. The file is a standard kubeconfig with a
# cluster-admin user; it authenticates directly to the API server, which the
# Prometheus API hop (0d) relies on for 'oc exec ... curl'.
# ---------------------------------------------------------------------------
log "Auth: resolving kubeconfig for all oc/curl calls"
if [[ -f "${KUBECONFIG_FILE}" ]]; then
    # Validate it is a parseable kubeconfig before trusting it to auth.
    oc version --client > /dev/null 2>&1 || true
    grep -q "apiVersion:" "${KUBECONFIG_FILE}" \
        || fail "injected kubeconfig at ${KUBECONFIG_FILE} is not a kubeconfig file"
    # Export for THIS process and all children (oc, curl wrappers, etc.)
    export KUBECONFIG="${KUBECONFIG_FILE}"
    # Record WHICH identity we are running as WITHOUT leaking credentials:
    # 'oc whoami' prints the username only - never the token.
    # NOTE: NO --timeout flag: the payload's oc 4.15 client rejects it
    # (verified: 'error: unknown flag: --timeout').
    log "Auth: KUBECONFIG exported: ${KUBECONFIG_FILE} (user: $(oc whoami 2>&1 || echo 'whoami failed'))"
else
    # No injected secret -> fall back to the framework-default in-cluster
    # ServiceAccount credential (the must-gather pod runs with a
    # cluster-admin-bound SA - see framework clusterrolebinding). Unset
    # rather than point at a file so 'oc' uses the pod's own token.
    unset KUBECONFIG
    log "Auth: no kubeconfig at ${KUBECONFIG_FILE} - using in-cluster SA credential (user: $(oc whoami 2>&1 || echo 'whoami failed'))"
fi

# ---------------------------------------------------------------------------
# PART 0 - PRE-FLIGHT CHECKS
# ---------------------------------------------------------------------------

# 0a. kube API must be reachable with the credentials from PART -1 above.
#     ('oc whoami' WITHOUT --timeout: unknown flag on the payload's oc 4.15.)
log "Pre-flight: verifying API server access"
oc whoami > "${OUT_DIR}/whoami.txt" 2>&1 \
    || fail "oc whoami failed - gather pod has no cluster access (see whoami.txt)"

# 0b. SNO node readiness. On a healthy 1-node SNO, master-0 must be Ready and
#     carry ALL roles (control-plane, master, worker).
log "Pre-flight: checking node '${SNO_NODE}' readiness"
NODE_JSON=$(oc get node "${SNO_NODE}" -o json 2>&1) \
    || fail "node '${SNO_NODE}' not found: ${NODE_JSON}"
{
    echo "$NODE_JSON"
} > "${METADATA_DIR}/node-${SNO_NODE}.json"
NODE_PHASE=$(echo "$NODE_JSON" | jq -r '[.status.conditions[]? | select(.type=="Ready")][0].status // "Unknown"')
[[ "${NODE_PHASE}" == "True" ]] \
    || fail "node '${SNO_NODE}' is not Ready (Ready=${NODE_PHASE:-unknown})"
echo "$NODE_JSON" | jq -c '.metadata.labels // {}' > "${METADATA_DIR}/node-${SNO_NODE}-labels.json"
grep -q 'node-role.kubernetes.io/control-plane' "${METADATA_DIR}/node-${SNO_NODE}-labels.json" \
    || warn "node missing control-plane role label (expected on SNO)"

# 0c. prometheus-k8s-0 must exist and be Running+Ready. The field-selector
#     narrows the watch server-side; we grep the exact pod name because some
#     upgrades briefly rename/migrate the statefulset ordinal.
log "Pre-flight: locating prometheus pod '${PROM_POD}' in ${MON_NS}"
PROM_POD=$(oc get pods -n "${MON_NS}" \
        -l prometheus=k8s --field-selector=status.phase==Running \
        --no-headers -o custom-columns=":metadata.name" 2>/dev/null \
    | grep -x "${PROM_POD}" || true)
[[ -n "${PROM_POD}" ]] \
    || fail "pod '${PROM_POD}' not Running in ${MON_NS} (prometheus broken?)"
# NOTE 1: the Ready condition status is the STRING "True" (capital) — grep
#        must be case-insensitive (a plain 'grep -q true' misses it and
#        falsely fails: observed 2026-09-29, pod 6/6 Ready -> FATAL).
# NOTE 2: the pod may be mid-restart (6 restarts in 16h was observed); bound
#        a 180s retry so a transient NotReady at probe time is not fatal.
READY_OK=0
for i in $(seq 1 18); do
    ST=$(oc get pod -n "${MON_NS}" "${PROM_POD}" -o json 2>/dev/null | \
         jq -r '.status.conditions[] | select(.type=="Ready") | .status' 2>/dev/null | head -1)
    [[ "${ST}" == "True" ]] && { READY_OK=1; break; }
    [[ ${i} -lt 18 ]] && log "Pod ${PROM_POD} Ready=${ST:-?} - waiting (attempt ${i}/18)"
    sleep 10
done
[[ ${READY_OK} -eq 1 ]] \
    || fail "pod '${PROM_POD}' is Running but not Ready after 180s (last: Ready=${ST:-unknown})"
oc get pod -n "${MON_NS}" "${PROM_POD}" -o json > "${METADATA_DIR}/${PROM_POD}.json"

# 0d. Prometheus HTTP API reachability + web-port detection. OCP managed
#     prometheus listens on 127.0.0.1:9090 behind a kube-rbac-proxy on :9091;
#     'oc exec ... curl 127.0.0.1:<port>' bypasses the proxy entirely and
#     talks to the real process (which is why the admin POST works without a
#     token). We probe both ports and remember the winner in PROM_PORT.
#     NOTE: this proves the HTTP API is up - it does NOT prove the ADMIN mux
#     is enabled (Prom 3.x feature-gates it; checked live in PART 1).
log "Pre-flight: checking Prometheus HTTP API (port probe 9090/9091)"
for p in 9090 9091; do
    SNAPLIST=$(oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
        curl -fsS -m "${ADMIN_TIMEOUT}" "http://127.0.0.1:${p}/api/v1/status/runtimeinfo" 2>/dev/null || true)
    [[ -n "${SNAPLIST}" ]] && { PROM_PORT="${p}"; break; }
done
[[ -n "${SNAPLIST}" ]] \
    || fail "Prometheus HTTP API unreachable on ${PROM_POD} (tried 127.0.0.1:9090 and :9091 from inside the pod)"
echo "${SNAPLIST}" > "${METADATA_DIR}/prometheus-runtimeinfo.json"
PROM_VER=$(echo "${SNAPLIST}" | jq -r '.data.version // empty' 2>/dev/null)
log "Prometheus HTTP API on 127.0.0.1:${PROM_PORT} inside ${PROM_POD}; version: ${PROM_VER:-unknown}"

# 0d2. TSDB data dir sanity: record what we will copy in direct mode, and its
#      size (budget check for the must-gather ephemeral volume; the framework
#      enforces --volume-percentage on exactly this copy).
log "Pre-flight: inventorying ${PROM_DATA_DIR} on ${PROM_POD}"
oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
    sh -c 'echo "=== blocks"; ls -1d '"${PROM_DATA_DIR}"'/*/ 2>/dev/null; \
           echo "=== wal"; ls -la '"${PROM_DATA_DIR}"'/wal 2>/dev/null | head; \
           echo "=== snapshots (pre-existing)"; ls -1 '"${PROM_DATA_DIR}"'/snapshots 2>/dev/null; true' \
    > "${METADATA_DIR}/prometheus-tsdb-inventory.txt" 2>&1 || true
# numeric KiB so it parses cleanly; humanize for the log line
TSDB_KIB=$(oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
    du -sk "${PROM_DATA_DIR}" 2>/dev/null | awk '{print $1}')
TSDB_MIB=$(( ${TSDB_KIB:-0} / 1024 ))
log "Live TSDB size: ${TSDB_MIB} MiB (direct-mode oc cp budget; the framework caps the pod volume at --volume-percentage)"

# 0e. Disk sanity: snapshots are written ON the pod's local disk (SNO = the
#     PV backing /prometheus), so a nearly-full target will make the snapshot
#     API fail with 'no space left'.
log "Pre-flight: checking free space in ${PROM_DATA_DIR} on ${PROM_POD}"
oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- df -h "${PROM_DATA_DIR}" \
    | tee "${METADATA_DIR}/prometheus-df.txt" >/dev/null \
    || warn "df check failed (continuing)"

# 0f. SOURCE-SIDE PLANNING: block inventory -> window selection -> retention
#     detect -> size-budget gate. All of this runs BEFORE the admin-API
#     snapshot probe and BEFORE any byte leaves the pod: a budget miss or an
#     empty window must abort cheaply, with nothing written to the target.
log "Planning: block inventory, window selection, retention, size budget"
BLOCK_INV=$(remote_block_inventory)
if [[ -z "${BLOCK_INV}" ]]; then
    fail "block inventory returned no compacted blocks in ${PROM_DATA_DIR} (only WAL/head? - data may be fresh or all in the head yet)"
fi
printf '%s\n' "${BLOCK_INV}" > "${METADATA_DIR}/block-inventory.tsv"
log "Planning: $(grep -c . <<<"${BLOCK_INV}") compacted block(s) on ${PROM_POD}"

select_window "${BLOCK_INV}"
retention_detect
size_budget_gate "${BLOCK_INV}"

# ---------------------------------------------------------------------------
# PART 1 - EXECUTION: obtain a crash-consistent TSDB copy
#
# PREFERRED (MODE=snapshot):
#   'POST /api/v1/admin/tsdb/snapshot' makes prometheus copy ALL blocks + the
#   full WAL into ${PROM_DATA_DIR}/snapshots/<UTC-timestamp> atomically with
#   respect to its own writes - the textbook safe export.
#
#   CAVEAT (verified on THIS cluster, 2026-09-29): Prometheus >= 3.x
#   feature-gates the admin HTTP API behind
#     --enable-feature=prometheus-admin-api
#   and the OCP prometheus-operator does NOT set it by default. The probe
#   below therefore expects (and handles) 500 {"error":"admin APIs disabled"}.
#
# FALLBACK (MODE=direct):
#   A TSDB on disk is CRASH-CONSISTENT by design: compacted block dirs are
#   self-contained, and the WAL + chunks_head are replayed by whoever re-opens
#   the data dir. Copying /prometheus while prometheus runs therefore yields a
#   TSDB that a standalone prometheus can open; the only possible loss is the
#   torn tail of the NEWEST WAL segment (partial write in flight during the
#   copy window) - standard forensic behavior, recorded in the metadata.
#   No write to the live pod, no remote cleanup needed.
#
# Enabling the real admin API on this cluster (future runs, optional):
#   oc patch prometheus k8s -n openshift-monitoring --type=merge \
#     -p '{"spec":{"enableFeatures":["delayed-compaction","use-uncached-io","prometheus-admin-api"]}}'
#   (pod restarts once; PART 1 will then take the snapshot path automatically)
# ---------------------------------------------------------------------------
log "Probing Prometheus Admin API on 127.0.0.1:${PROM_PORT} (POST admin/tsdb/snapshot)"
SNAP_RESP=$(oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
    curl -sS -m 300 -X POST "http://127.0.0.1:${PROM_PORT}/api/v1/admin/tsdb/snapshot" 2>&1)
SNAP_RC=$?
echo "${SNAP_RESP}" > "${METADATA_DIR}/snapshot-probe-response.txt"

if [[ ${SNAP_RC} -eq 0 && "$(echo "${SNAP_RESP}" | jq -r '.status // empty' 2>/dev/null)" == "success" ]]; then
    MODE="snapshot"
    SNAPSHOT_NAME=$(echo "${SNAP_RESP}" | jq -r '.data.name // empty')
    [[ -n "${SNAPSHOT_NAME}" && "${SNAPSHOT_NAME}" != "null" ]] \
        || fail "snapshot response had no data.name: ${SNAP_RESP}"
    log "Admin API snapshot created: ${SNAPSHOT_NAME}"
else
    MODE="direct"
    log "Admin API snapshot unavailable (rc=${SNAP_RC}; ${SNAP_RESP:0:120})"
    log "Falling back to MODE=direct: copy the crash-consistent TSDB at ${PROM_DATA_DIR} as-is"
fi

# ---------------------------------------------------------------------------
# PART 2 - SELECTIVE EXTRACTION into the must-gather output dir
#
# Only SELECTED paths leave the pod (feature: time-window export). Each item
# is pulled with the documented exec-pipe form
#   oc exec ... -- tar cf - -C <remote-root> <item1> <item2> ... | tar xf - -C <local>
# (plain 'oc cp pod:<subdir>' mangles absolute sub-paths - verified broken
# 2026-10-02 - while -C + relative member names works in both modes).
#
#   MODE=snapshot:  remote root <PROM_DATA_DIR>/snapshots/<SNAPNAME>
#   MODE=direct:    remote root <PROM_DATA_DIR>
#   local:          ${TSDB_OUT_DIR}/<UTC-ts>/{<selected block dirs>,[wal/],[chunks_head/]}
#
#   - windowless runs: SELECTED_BLOCKS = every block (full export)
#   - window runs:     only intersecting blocks; excluded blocks never leave
#   - WAL:             copied only when WAL_INCLUDED=1 (INCLUDE_WAL)
#   - queries.active / lock / snapshots/ are Ephemeral open-state: the tar
#     member list never names them (direct mode) - the local prometheus
#     recreates them on startup.
# A mid-transfer drop is retried once before failing.
# ---------------------------------------------------------------------------
DIRECT_TARGET="${TSDB_OUT_DIR}/$(date -u +%Y%m%dT%H%M%SZ)"
REMOTE_ROOT="${PROM_DATA_DIR}"
[[ "${MODE}" == "snapshot" ]] && REMOTE_ROOT="${PROM_SNAP_DIR}/${SNAPSHOT_NAME}"

# member list: selected block dirs + optional head dirs (relative names)
CP_MEMBERS=""
for n in ${SELECTED_BLOCKS}; do CP_MEMBERS+="${n} "; done
if (( WAL_INCLUDED )); then
    CP_MEMBERS+="wal chunks_head "
fi
[[ -n "${CP_MEMBERS}" ]] || fail "nothing selected to extract (selection returned no paths)"

extract_paths() {
    # $1 = stderr log file (remote+local combined). Return codes:
    #   0 = clean
    #   2 = remote tar hit ONLY the expected live-WAL 'file changed as we
    #       read it' error (the torn-tail loss bound documented in the header -
    #       the WAL is being appended to while we read it; the copy is still
    #       crash-consistent and a re-opening prometheus replays what landed)
    #   1 = any other, real failure (local write error / non-torn-tail remote
    #       error). Distinguishing matters: a torn-tail is NOT a mid-transfer
    #       drop, so it must not be "retried" as if the copy were corrupt.
    local errfile="$1"
    oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
        tar cf - -C "${REMOTE_ROOT}" ${CP_MEMBERS} 2> "${errfile}.remote" \
        | tar xf - -C "${DIRECT_TARGET}" 2> "${errfile}.local"
    local rc_remote="${PIPESTATUS[0]}" rc_local="${PIPESTATUS[1]}"
    cat "${errfile}.remote" "${errfile}.local" > "${errfile}" 2>/dev/null || true
    # local side: non-zero is always a real problem (cannot write the copy)
    [[ "${rc_local}" -ne 0 ]] && return 1
    if [[ "${rc_remote}" -ne 0 ]]; then
        # strip the benign lines; if nothing of substance remains it's a
        # torn-tail (return 2), otherwise a genuine error (return 1)
        local substantive
        substantive=$(grep -vE 'file changed as we read it|command terminated with exit code' \
            "${errfile}.remote" 2>/dev/null | grep -v '^[[:space:]]*$' || true)
        if [[ -z "${substantive}" ]]; then
            log "WARN: remote tar hit the expected live-WAL torn-tail error (crash-consistent copy; loss <= tail of newest in-flight WAL segment)"
            return 2
        fi
        return 1
    fi
    return 0
}

log "Extracting ${PROM_POD}:${REMOTE_ROOT}[<${CP_MEMBERS}>] -> ${DIRECT_TARGET} (mode=${MODE}, $(tr ' ' '\n' <<<"${CP_MEMBERS}" | grep -c .) path(s))"
mkdir -p "${DIRECT_TARGET}"
extract_paths "${OUT_DIR}/oc-cp.stderr"; XRC=$?
if [[ ${XRC} -ne 0 && ${XRC} -ne 2 ]]; then
    log "tar-pipe extraction failed (rc=${XRC}); retrying once"
    extract_paths "${OUT_DIR}/oc-cp.stderr.retry"; XRC=$?
    [[ ${XRC} -ne 0 && ${XRC} -ne 2 ]] \
        && fail "TSDB extraction failed twice (see ${OUT_DIR}/oc-cp.stderr*)"
fi
# drop any open-state artifacts that sneaked into the copy (defensive: the
# member list already excludes them in direct mode; a snapshot never had them)
rm -f "${DIRECT_TARGET}/queries.active" "${DIRECT_TARGET}/lock" 2>/dev/null || true
cp "${OUT_DIR}/oc-cp.stderr" "${METADATA_DIR}/oc-cp.stderr" 2>/dev/null || true
log "Extraction complete: $(du -sh "${DIRECT_TARGET}" 2>/dev/null | cut -f1) total ($(( $(du -sb -- "${DIRECT_TARGET}" 2>/dev/null | awk '{print $1}') / 1024 / 1024 )) MiB)"

# ---------------------------------------------------------------------------
# PART 2b - EXPORT GUARDS: enforce the size cap (default 5 GiB) and the
# optional --at point-in-time filter on the LOCAL copy. See
# export_tsdb_guard (above) for what is pruned and why the live pod stays
# untouched in all cases.
# ---------------------------------------------------------------------------
log "Applying export guards (cap=${MAX_GB} GiB${AT_SECONDS:+, at=$(date -u -d "@${AT_SECONDS}" +%Y-%m-%dT%H:%M:%SZ)})"
export_tsdb_guard "${DIRECT_TARGET}"
log "Export guards done: $(du -sh "${DIRECT_TARGET}" 2>/dev/null | cut -f1) final ($(grep 'blocks_remaining' "${METADATA_DIR}/export-guards.txt" 2>/dev/null | cut -d= -f2) blocks; see ${METADATA_DIR}/export-guards.txt)"

# ---------------------------------------------------------------------------
# PART 2c - COMPRESSION (feature: measured 2026-10-02, see the feature doc
# 'Outcomes'). Default zstd -6 = ~74% smaller, ~0.5s on a 1.1GiB TSDB.
#
# The extracted tree stays as-is (playback mounts the unpacked dir); the
# archive is an ADDITIONAL artifact for transfer/storage. Layout:
#   prometheus-snapshot/<TS>/            <- intact (or pruned) block tree
#   prometheus-snapshot/<TS>.tar.zstd    <- (COMPRESS=zstd)   tar | zstd -6 -T0
#   prometheus-snapshot/<TS>.tar.gz      <- (COMPRESS=gzip)
#   prometheus-snapshot/SHA256SUMS       <- checksums for EVERY artifact
# NOTE: the archive suffix is '.tar.' + $COMPRESS, i.e. zstd runs name it
#       <TS>.tar.zstd (NOT the default zstd extension .zst). Unpack:
#         tar -I zstd -xf <TS>.tar.zstd -C <newdir>   (or: cat <TS>.tar.zstd | zstd -d | tar xf -)
# ---------------------------------------------------------------------------
COMPRESS_STAT=""
if [[ "${COMPRESS}" != "none" ]]; then
    ARCHIVE="${TSDB_OUT_DIR}/$(basename "${DIRECT_TARGET}").tar.${COMPRESS}"
    log "Compressing extraction: ${DIRECT_TARGET} -> ${ARCHIVE} (${COMPRESS})"
    COMPRESS_START=$(date +%s)
    case "${COMPRESS}" in
        zstd)
            ( cd "${DIRECT_TARGET}" && tar -cf - . ) | zstd -6 -T0 -q -o "${ARCHIVE}" \
                || { COMPRESS_STAT="failed"; warn "zstd compression failed - keeping the unarchived tree only"; }
            ;;
        gzip)
            ( cd "${DIRECT_TARGET}" && tar -cf - . ) | gzip -6 -c > "${ARCHIVE}" \
                || { COMPRESS_STAT="failed"; warn "gzip compression failed - keeping the unarchived tree only"; }
            ;;
    esac
    COMPRESS_END=$(date +%s)
    if [[ "${COMPRESS_STAT}" != "failed" ]]; then
        RAW_B=$(du -sb -- "${DIRECT_TARGET}" | awk '{print $1}')
        ARC_B=$(stat -c %s "${ARCHIVE}")
        COMPRESS_STAT="$(( COMPRESS_END - COMPRESS_START ))s raw=${RAW_B}B archive=${ARC_B}B ratio=$(awk -v r=${RAW_B} -v a=${ARC_B} 'BEGIN{printf "%.3f", (a>0)? a/r : 0}')"
        log "Compression done: ${COMPRESS_STAT}"
    fi
else
    COMPRESS_STAT="skipped (COMPRESS=none)"
fi

# SHA256SUMS for every shipped artifact (archive + the tree's top entries)
SUMS_FILE="${TSDB_OUT_DIR}/SHA256SUMS"
if [[ -f "${ARCHIVE:-}" ]]; then
    ( cd "${TSDB_OUT_DIR}" && sha256sum "$(basename "${ARCHIVE}")" > "${SUMS_FILE}" )
fi
log "Artifacts under ${TSDB_OUT_DIR}: $(ls -1 "${TSDB_OUT_DIR}" | tr '\n' ' ')"
# build the unpack hint from the ACTUAL archive name (suffix is '.tar.'+
# $COMPRESS, so zstd is '.tar.zstd', not zstd's default '.zst')
if [[ -f "${ARCHIVE:-/nonexistent}" ]]; then
    case "${COMPRESS}" in
        zstd) UNPACK_CMD="tar -I zstd -xf $(basename "${ARCHIVE}") -C <newdir>" ;;
        gzip) UNPACK_CMD="tar -I gzip -xf $(basename "${ARCHIVE}") -C <newdir>" ;;
        *)    UNPACK_CMD="(none - COMPRESS=none, use the unpacked tree directly)" ;;
    esac
else
    UNPACK_CMD="(no archive this run)"
fi
{
    echo "compress=${COMPRESS}"
    echo "status=${COMPRESS_STAT}"
    [[ -f "${ARCHIVE:-/nonexistent}" ]] && echo "archive=$(basename "${ARCHIVE}")" && sha256sum "${ARCHIVE}" | awk '{print "archive_sha256="$1}'
    echo "unpack=${UNPACK_CMD}"
    echo "playback=mount the UNPACKED tree / the intact ${DIRECT_TARGET} - see playback/docker-compose.yml"
} > "${METADATA_DIR}/compression.txt"

# ---------------------------------------------------------------------------
# PART 3 - FORENSIC METADATA (small context files that make the copied TSDB
#         usable offline without re-querying a cluster that may be gone)
# ---------------------------------------------------------------------------
log "Gathering forensic metadata (mode=${MODE})"
REMOTE_VERIFY_PATH="${PROM_SNAP_DIR}/${SNAPSHOT_NAME}"
[[ "${MODE}" == "direct" ]] && REMOTE_VERIFY_PATH="${PROM_DATA_DIR}"
oc adm describe pod -n "${MON_NS}" "${PROM_POD}" \
    > "${METADATA_DIR}/pod-describe.txt" 2>&1 || true
oc logs -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" --tail=2000 \
    > "${METADATA_DIR}/prometheus-logs-tail.log" 2>&1 || true
# in-cluster block inventory (remote view, pre-copy)
oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
    promtool tsdb list "${REMOTE_VERIFY_PATH}" \
    > "${METADATA_DIR}/tsdb-remote-blocks.txt" 2>&1 || true
# Prometheus config (promtool config dump) - reveals retention, remote writes,
# and scrape configs; safe to include (no secrets in the rendered config).
# (Path probed from the live pod: config_out/prometheus.env.yaml.)
oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
    sh -c 'promtool config dump /etc/prometheus/config_out/prometheus.env.yaml \
        || promtool config dump /etc/prometheus/configout/config_out.yaml' \
    > "${METADATA_DIR}/prometheus-config.yaml" 2>&1 || true
oc get -n "${MON_NS}" prometheus k8s -o yaml \
    | sed -e 's/\(token: \).*/\1<redacted>/' -e 's/\(bearerToken: \).*/\1<redacted>/' \
    > "${METADATA_DIR}/prometheus-crd.yaml" 2>&1 || true
oc get -n "${MON_NS}" pod "${PROM_POD}" -o jsonpath='{range .spec.containers[?(@.name=="prometheus")].args[*]}{.}{"\n"}{end}' \
    > "${METADATA_DIR}/prometheus-args.txt" 2>&1 || true
# which extraction path ran + why - the playbook reads this
{
    echo "mode=${MODE}"
    echo "prom_port=${PROM_PORT}"
    echo "max_gb=${MAX_GB}"
    echo "at_timestamp=${AT_TS:-(none)}"
    echo "max_size=${MAX_SIZE}"
    echo "size_policy=${SIZE_POLICY}"
    echo "compress=${COMPRESS}"
    echo "window_active=${WINDOW_ACTIVE}"
    echo "snapshot_name=${SNAPSHOT_NAME:-(none)}"
    echo "local_target=${DIRECT_TARGET}"
    echo "remote_root=${REMOTE_ROOT}"
    [[ "${MODE}" == "direct" ]] \
        && echo "note=direct selective copy of the live TSDB; only selected blocks + head dirs were transferred; local prometheus replays the WAL on startup (worst case loss: torn tail of the newest WAL segment)"
} > "${METADATA_DIR}/extraction-mode.json"

# ---------------------------------------------------------------------------
# time-window.json (feature contract; written for EVERY run - a windowless
# run records since=<oldest>/until=now and an empty excluded list)
# ---------------------------------------------------------------------------
TW_SINCE=$(date -u -d "@$(( OLDEST_MS / 1000 ))" +%Y-%m-%dT%H:%M:%SZ)
TW_UNTIL=$(date -u -d "@${UNTIL_SECONDS}" +%Y-%m-%dT%H:%M:%SZ)
[[ -n "${SINCE}" ]] && TW_SINCE=$(date -u -d "@${SINCE_SECONDS}" +%Y-%m-%dT%H:%M:%SZ)
{
    jq -n \
        --arg since "${TW_SINCE}" \
        --arg until "${TW_UNTIL}" \
        --arg wal "${WAL_INCLUDED}" \
        --arg note "$( [[ "${WINDOW_ACTIVE}" -eq 1 && -n "${EXCLUDED_BLOCKS}" ]] && echo 'Excluded blocks outside window to reduce gather size' || echo 'Full export: no time window requested' )" \
        --argjson included "$( jq -Rn '[inputs | select(length>0)]' <<<"$(tr ' ' '\n' <<<"${SELECTED_BLOCKS}" | grep . || true)" )" \
        --argjson excluded "$( jq -Rn '[inputs | select(length>0)]' <<<"$(tr ' ' '\n' <<<"${EXCLUDED_BLOCKS}" | grep . || true)" )" \
        '{
            since: $since, until: $until,
            blocks_included: $included, blocks_excluded: $excluded,
            include_wal: ($wal == "1"),
            notes: $note
        }'
} > "${METADATA_DIR}/time-window.json"

# INTEGRITY CHECK (in-cluster, using the prom pod's exact promtool).
# promtool 3.x has NO 'tsdb verify' subcommand (removed); the real, read-only
# checks are:
#   - 'tsdb list'    : reads every block's meta.json (ULID + time bounds)
#   - 'tsdb analyze' : loads postings + a chunk page for a block (real read)
# Both are safe on the LIVE dir (read-only). We analyze the newest compacted
# block only (full analyze of a multi-GB TSDB is slow; one block proves the
# index+chunk read path end to end).
log "Verifying TSDB integrity in-cluster (promtool tsdb list + analyze on ${PROM_POD})"
oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
    promtool tsdb list "${REMOTE_VERIFY_PATH}" \
    > "${METADATA_DIR}/tsdb-verify.txt" 2>&1
# newest compacted block = highest ULID that is a real block dir (not wal/chunks_head/snapshots)
NEWEST_BLOCK=$(oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
    sh -c 'ls -1 '"${PROM_DATA_DIR}"' 2>/dev/null | grep -E "^[0-9A-Z]{26}$" | sort | tail -1')
if [[ -n "${NEWEST_BLOCK}" ]]; then
    log "Analyzing newest block ${NEWEST_BLOCK} (postings+chunk read probe)"
    # --sandbox-dir-root=/tmp keeps promtool's temp block sandbox OUT of the
    # live ${PROM_DATA_DIR} (the default writes tmp_dbro_sandbox* next to the
    # TSDB, which would otherwise be copied into the export).
    oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
        promtool tsdb analyze --sandbox-dir-root=/tmp "${PROM_DATA_DIR}" "${NEWEST_BLOCK}" \
        > "${METADATA_DIR}/tsdb-analyze-newest.txt" 2>&1 \
        || warn "promtool tsdb analyze on ${NEWEST_BLOCK} reported issues (see tsdb-analyze-newest.txt)"
else
    warn "no compacted block dir found in ${PROM_DATA_DIR} (only WAL? data may be all in head)"
fi
# LOCAL structural check of the copy (payload ships NO promtool - it is a slim
# RHEL base; do not assume promtool here). The authoritative 'does it open'
# test is the playback Prometheus, so here we verify the copy LOOKS complete:
log "Structural check of local copy ${DIRECT_TARGET}"
LOCAL_BLOCKS=$(ls -1 "${DIRECT_TARGET}" 2>/dev/null | grep -cE '^[0-9A-Z]{26}$' || true)
LOCAL_WAL=$( [[ -d "${DIRECT_TARGET}/wal" ]] && echo yes || echo no )
LOCAL_META_OK=1
for b in ${DIRECT_TARGET}/[0-9A-Z][0-9A-Z][0-9A-Z]*/ ; do
    [[ -f "${b}meta.json" ]] || { LOCAL_META_OK=0; break; }
done
[[ ${LOCAL_BLOCKS:-0} -gt 0 ]] || LOCAL_META_OK=0     # empty copy: not ok
{
    echo "local_blocks=${LOCAL_BLOCKS:-0}"
    echo "local_wal_present=${LOCAL_WAL}"
    echo "local_all_blocks_have_meta.json=${LOCAL_META_OK}"
} > "${METADATA_DIR}/tsdb-local-struct.txt" 2>&1
[[ ${LOCAL_META_OK} -eq 1 ]] \
    || warn "local copy structural check found a problem (see tsdb-local-struct.txt)"

# ---------------------------------------------------------------------------
# PART 4 - CLEANUP: remove the temporary admin-API snapshot on the target pod
#
# Snapshot mode only: the snapshot occupies pod-local disk (SNO local PV);
# the extracted copy lives in /must-gather and ships back to the operator.
# Direct mode performs no writes to the pod - nothing to clean up.
# (The EXIT trap is the safety net for aborted runs.)
# ---------------------------------------------------------------------------
if [[ "${MODE}" == "snapshot" && -n "${SNAPSHOT_NAME}" ]]; then
    log "Cleaning up remote snapshot '${SNAPSHOT_NAME}'"
    oc exec -n "${MON_NS}" "${PROM_POD}" -c "${PROM_CONTAINER}" -- \
        rm -rf "${PROM_SNAP_DIR}/${SNAPSHOT_NAME}" \
        && log "Remote snapshot removed" \
        || warn "remote snapshot removal failed"
    SNAPSHOT_NAME=""   # clear so the EXIT trap does not double-delete
fi

sync   # flush to the rsync sidecar before the framework copies /must-gather
log "DONE - mode=${MODE}; TSDB in ${DIRECT_TARGET}; archive=$(basename "${ARCHIVE:-none}"); metadata in ${METADATA_DIR}"
