$ oc adm must-gather --volume-percentage=95 --image=quay.io/midu/prometheus-tsdb-gather:latest \\
$     --dest-dir $(pwd)/demo-run-clamp -- /usr/bin/gather --since 30d --until 29d
(requested window is 30 days old - retention (15d) already GCd that data)

P=$(find demo-run-clamp -maxdepth 1 -type d -name "quay-io-*")

$ grep -E "WARN: requested window|Window:|DONE - mode=" $P/gather.log
